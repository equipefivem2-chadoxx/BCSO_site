<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<style>
    :root {
        --primary: #3b82f6;
        --primary-hover: #2563eb;
        --danger: #ef4444;
        --danger-hover: #dc2626;
        --bg-base: #111827;
        --bg-panel: #1f2937;
        --bg-input: #374151;
        --text-main: #f9fafb;
        --text-muted: #9ca3af;
        --border-color: #374151;
        --radius: 6px;
    }

    body {
        margin: 0;
        background-color: var(--bg-base);
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        color: var(--text-main);
        min-height: 100vh;
    }

    #admin-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 40px 20px;
    }
    
    h1, h2, h3 {
        margin-top: 0;
        font-weight: 600;
    }

    .page-header {
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 15px;
        margin-bottom: 30px;
    }
    
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }
    
    .stat-card {
        background: var(--bg-panel);
        border: 1px solid var(--border-color);
        border-radius: var(--radius);
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 20px;
    }
    
    .stat-card i {
        font-size: 2rem;
        color: var(--primary);
    }
    
    .stat-info div {
        font-size: 0.85rem;
        color: var(--text-muted);
        text-transform: uppercase;
    }
    
    .stat-info span {
        font-size: 1.8rem;
        font-weight: 700;
    }

    .admin-grid {
        display: grid;
        grid-template-columns: 350px 1fr;
        gap: 20px;
        align-items: start;
    }
    
    @media (max-width: 1100px) {
        .admin-grid { grid-template-columns: 1fr; }
    }

    .panel-box {
        background: var(--bg-panel);
        border: 1px solid var(--border-color);
        border-radius: var(--radius);
        padding: 25px;
    }

    .form-group {
        margin-bottom: 15px;
    }
    
    .form-group label {
        display: block;
        margin-bottom: 5px;
        font-size: 0.85rem;
        color: var(--text-muted);
    }
    
    .form-control {
        width: 100%;
        padding: 10px 12px;
        background: var(--bg-input);
        border: 1px solid var(--border-color);
        border-radius: var(--radius);
        color: var(--text-main);
        box-sizing: border-box;
    }
    
    .form-control:focus {
        outline: none;
        border-color: var(--primary);
    }

    /* Switch Design */
    .switch-container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: var(--bg-base);
        padding: 12px 15px;
        border-radius: var(--radius);
        border: 1px solid var(--border-color);
        margin-top: 15px;
    }
    .switch { position: relative; display: inline-block; width: 40px; height: 20px; }
    .switch input { opacity: 0; width: 0; height: 0; }
    .slider { position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background-color: var(--bg-input); transition: .3s; border-radius: 20px; border: 1px solid var(--border-color); }
    .slider:before { position: absolute; content: ""; height: 14px; width: 14px; left: 2px; bottom: 2px; background-color: white; transition: .3s; border-radius: 50%; }
    input:checked + .slider { background-color: var(--primary); border-color: var(--primary); }
    input:checked + .slider:before { transform: translateX(20px); }

    .btn {
        background: var(--primary);
        color: #fff;
        border: none;
        padding: 10px 15px;
        border-radius: var(--radius);
        cursor: pointer;
        width: 100%;
        font-weight: 600;
        transition: background 0.2s;
    }
    .btn:hover { background: var(--primary-hover); }
    
    .btn-danger { background: var(--danger); width: auto; }
    .btn-danger:hover { background: var(--danger-hover); }

    /* Tableaux */
    .table-responsive { overflow-x: auto; margin-top: 15px; }
    .agent-table { width: 100%; border-collapse: collapse; text-align: left; }
    .agent-table th { 
        background: var(--bg-base); 
        padding: 12px 15px; 
        color: var(--text-muted); 
        font-size: 0.85rem; 
        border-bottom: 2px solid var(--border-color); 
    }
    .agent-table td { 
        padding: 12px 15px; 
        border-bottom: 1px solid var(--border-color); 
        font-size: 0.9rem; 
    }
    
    .badge { padding: 4px 8px; border-radius: 4px; font-size: 0.75rem; font-weight: bold; }
    .badge-admin { background: rgba(59, 130, 246, 0.2); color: var(--primary); }
    .badge-user { background: rgba(156, 163, 175, 0.2); color: var(--text-muted); }
    
    .actions-cell { display: flex; gap: 8px; }
    .btn-action { 
        background: var(--bg-input); 
        border: none; 
        color: var(--text-main); 
        padding: 8px; 
        border-radius: 4px; 
        cursor: pointer; 
    }
    .btn-action:hover { background: var(--border-color); }
    .btn-action.delete:hover { background: var(--danger); color: white; }

    .edit-row { background: var(--bg-base); display: none; }
    .edit-row td { padding: 20px; border-bottom: 2px solid var(--primary); }

    .danger-zone { margin-top: 40px; border-color: var(--danger); background: rgba(239, 68, 68, 0.05); }
    .danger-zone h2 { color: var(--danger); }
</style>

<div id="admin-container">
    <div class="page-header">
        <h1>Haut Commandement</h1>
        <p style="color: var(--text-muted); margin: 5px 0 0 0;">Gestion globale des accès et des effectifs</p>
    </div>

    <div class="stats-grid">
        <div class="stat-card">
            <i class="fas fa-users"></i>
            <div class="stat-info">
                <div>Total Agents</div>
                <span><%= agents.length %></span>
            </div>
        </div>
        <div class="stat-card">
            <i class="fas fa-shield-alt"></i>
            <div class="stat-info">
                <div>Admins Web</div>
                <span><%= agents.filter(a => a.isAdmin).length %></span>
            </div>
        </div>
        <div class="stat-card">
            <i class="fas fa-folder-open"></i>
            <div class="stat-info">
                <div>Rapports Stockés</div>
                <span><%= archivesCount %></span>
            </div>
        </div>
    </div>

    <div class="admin-grid">
        <!-- Formulaire d'enregistrement -->
        <div class="panel-box">
            <h2 style="font-size: 1.1rem; margin-bottom: 20px;"><i class="fas fa-user-plus"></i> Enregistrer un Agent</h2>
            
            <form action="/admin/ajouter" method="POST">
                <div class="form-group">
                    <label>Prénom</label>
                    <input type="text" name="prenom" class="form-control" required placeholder="John">
                </div>
                <div class="form-group">
                    <label>Nom</label>
                    <input type="text" name="nom" class="form-control" required placeholder="Doe">
                </div>
                <div class="form-group">
                    <label>Matricule</label>
                    <input type="text" name="matricule" class="form-control" required placeholder="55">
                </div>
                <div class="form-group">
                    <label>Téléphone</label>
                    <input type="text" name="telephone" class="form-control" placeholder="555-XXXX">
                </div>
                <div class="form-group">
                    <label>IBAN</label>
                    <input type="text" name="iban" class="form-control" placeholder="LS123...">
                </div>
                <div class="form-group">
                    <label>ID Discord *</label>
                    <input type="text" name="discordId" class="form-control" placeholder="1247264549489610897" required>
                </div>
                <div class="form-group">
                    <label>Grade RP</label>
                    <select name="grade" class="form-control" required>
                        <option value="Deputy Junior">Deputy Junior</option>
                        <option value="Deputy I">Deputy I</option>
                        <option value="Deputy II">Deputy II</option>
                        <option value="Deputy III">Deputy III</option>
                        <option value="SLO">SLO</option>
                        <option value="Sergeant I">Sergeant I</option>
                        <option value="Sergeant II">Sergeant II</option>
                        <option value="Sergeant Chef">Sergeant Chef</option>
                        <option value="Lieutenant">Lieutenant</option>
                        <option value="Sheriff">Sheriff</option>
                    </select>
                </div>

                <div class="switch-container">
                    <div>
                        <strong style="font-size: 0.9rem;">Accès Admin</strong>
                        <div style="font-size: 0.75rem; color: var(--text-muted);">Autoriser le panel MDT</div>
                    </div>
                    <label class="switch">
                        <input type="checkbox" name="isAdmin">
                        <span class="slider"></span>
                    </label>
                </div>

                <div class="switch-container">
                    <div>
                        <strong style="font-size: 0.9rem;">Droit de Suppression</strong>
                        <div style="font-size: 0.75rem; color: var(--text-muted);">Autoriser la suppression des archives</div>
                    </div>
                    <label class="switch">
                        <input type="checkbox" name="canDeleteArchives">
                        <span class="slider"></span>
                    </label>
                </div>
                
                <button type="submit" class="btn" style="margin-top: 20px;">Créer l'Agent</button>
            </form>
        </div>

        <div>
            <!-- Encadré Entreprise -->
            <div class="panel-box" style="margin-bottom: 20px;">
                <h2 style="font-size: 1.1rem; margin-bottom: 20px;"><i class="fas fa-handshake"></i> Accès Partenaires</h2>
                
                <form action="/admin/entreprise/ajouter" method="POST" style="margin-bottom: 20px; display: flex; gap: 10px;">
                    <input type="text" name="nom" class="form-control" placeholder="Nom" required>
                    <input type="text" name="identifiant" class="form-control" placeholder="Login" required>
                    <input type="text" name="motDePasse" class="form-control" placeholder="Mot de passe" required>
                    <button type="submit" class="btn" style="width: auto;">Ajouter</button>
                </form>

                <div class="table-responsive">
                    <table class="agent-table">
                        <thead>
                            <tr>
                                <th>Entreprise</th>
                                <th>Identifiant</th>
                                <th>Mot de passe</th>
                                <th style="text-align: right;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (typeof entreprises !== 'undefined' && entreprises && entreprises.length > 0) { %>
                                <% entreprises.forEach(ent => { %>
                                    <tr>
                                        <td><%= ent.nom %></td>
                                        <td><%= ent.identifiant %></td>
                                        <td><%= ent.motDePasse %></td>
                                        <td>
                                            <div class="actions-cell" style="justify-content: flex-end;">
                                                <button class="btn-action edit" onclick="toggleEditRow('ent-<%= ent._id %>')"><i class="fas fa-edit"></i></button>
                                                <form action="/admin/entreprise/supprimer/<%= ent._id %>" method="POST" style="margin:0;" onsubmit="return confirm('Révoquer cet accès ?');">
                                                    <button type="submit" class="btn-action delete"><i class="fas fa-trash"></i></button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                    <tr id="edit-ent-<%= ent._id %>" class="edit-row">
                                        <td colspan="4">
                                            <form action="/admin/entreprise/modifier/<%= ent._id %>" method="POST" style="display: flex; gap: 10px;">
                                                <input type="text" name="nom" value="<%= ent.nom %>" class="form-control" required>
                                                <input type="text" name="identifiant" value="<%= ent.identifiant %>" class="form-control" required>
                                                <input type="text" name="motDePasse" value="<%= ent.motDePasse %>" class="form-control" required>
                                                <button type="button" class="btn" style="width: auto; background: var(--bg-input);" onclick="toggleEditRow('ent-<%= ent._id %>')">Annuler</button>
                                                <button type="submit" class="btn" style="width: auto;">Sauvegarder</button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr><td colspan="4" style="text-align: center; color: var(--text-muted);">Aucune entreprise partenaire.</td></tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Tableau des agents -->
            <div class="panel-box">
                <h2 style="font-size: 1.1rem; margin-bottom: 20px;"><i class="fas fa-list"></i> Liste des Agents</h2>

                <div class="table-responsive">
                    <table class="agent-table">
                        <thead>
                            <tr>
                                <th>Matricule</th>
                                <th>Identité</th>
                                <th>Grade</th>
                                <th>Armement</th>
                                <th>Permissions</th>
                                <th style="text-align: right;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if(agents.length === 0) { %>
                                <tr>
                                    <td colspan="6" style="text-align: center; color: var(--text-muted); padding: 40px;">Aucun agent enregistré.</td>
                                </tr>
                            <% } %>
                            <% agents.forEach(agent => { %>
                                <tr>
                                    <td style="font-weight: bold;">#<%= agent.matricule %></td>
                                    <td><%= agent.prenom %> <%= agent.nom %></td>
                                    <td><%= agent.grade %></td>
                                    <td style="color: var(--text-muted); font-size: 0.8rem; font-style: italic;">
                                        Géré via annuaire
                                    </td>
                                    <td>
                                        <div style="display: flex; flex-direction: column; gap: 4px; align-items: flex-start;">
                                            <span class="badge <%= agent.isAdmin ? 'badge-admin' : 'badge-user' %>">
                                                <%= agent.isAdmin ? 'Admin' : 'Agent' %>
                                            </span>
                                            <% if(agent.canDeleteArchives) { %>
                                                <span class="badge" style="background: rgba(239, 68, 68, 0.2); color: var(--danger);">
                                                    Suppression
                                                </span>
                                            <% } %>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="actions-cell" style="justify-content: flex-end;">
                                            <button class="btn-action edit" onclick="toggleEditRow('<%= agent._id %>')"><i class="fas fa-edit"></i></button>
                                            <form action="/admin/supprimer/<%= agent._id %>" method="POST" style="margin:0;" onsubmit="return confirm('Supprimer cet agent ?');">
                                                <button type="submit" class="btn-action delete"><i class="fas fa-trash"></i></button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>

                                <tr id="edit-<%= agent._id %>" class="edit-row">
                                    <td colspan="6">
                                        <form action="/admin/modifier/<%= agent._id %>" method="POST">
                                            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; margin-bottom:15px;">
                                                <div class="form-group" style="margin:0;">
                                                    <label>Prénom</label>
                                                    <input type="text" name="prenom" value="<%= agent.prenom %>" class="form-control" required>
                                                </div>
                                                <div class="form-group" style="margin:0;">
                                                    <label>Nom</label>
                                                    <input type="text" name="nom" value="<%= agent.nom %>" class="form-control" required>
                                                </div>
                                                <div class="form-group" style="margin:0;">
                                                    <label>Matricule</label>
                                                    <input type="text" name="matricule" value="<%= agent.matricule %>" class="form-control" required>
                                                </div>
                                            </div>

                                            <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px; margin-bottom:20px;">
                                                <div class="form-group" style="margin:0;">
                                                    <label>Téléphone</label>
                                                    <input type="text" name="telephone" value="<%= agent.telephone %>" class="form-control">
                                                </div>
                                                <div class="form-group" style="margin:0;">
                                                    <label>IBAN</label>
                                                    <input type="text" name="iban" value="<%= agent.iban %>" class="form-control">
                                                </div>
                                                <div class="form-group" style="margin:0;">
                                                    <label>ID Discord</label>
                                                    <input type="text" name="discordId" value="<%= agent.discordId %>" class="form-control">
                                                </div>
                                                <div class="form-group" style="margin:0;">
                                                    <label>Grade</label>
                                                    <select name="grade" class="form-control" required>
                                                        <option value="Deputy Junior" <%= agent.grade === 'Deputy Junior' ? 'selected' : '' %>>Deputy Junior</option>
                                                        <option value="Deputy I" <%= agent.grade === 'Deputy I' ? 'selected' : '' %>>Deputy I</option>
                                                        <option value="Deputy II" <%= agent.grade === 'Deputy II' ? 'selected' : '' %>>Deputy II</option>
                                                        <option value="Deputy III" <%= agent.grade === 'Deputy III' ? 'selected' : '' %>>Deputy III</option>
                                                        <option value="SLO" <%= agent.grade === 'SLO' ? 'selected' : '' %>>SLO</option>
                                                        <option value="Sergeant I" <%= agent.grade === 'Sergeant I' ? 'selected' : '' %>>Sergeant I</option>
                                                        <option value="Sergeant II" <%= agent.grade === 'Sergeant II' ? 'selected' : '' %>>Sergeant II</option>
                                                        <option value="Sergeant Chef" <%= agent.grade === 'Sergeant Chef' ? 'selected' : '' %>>Sergeant Chef</option>
                                                        <option value="Lieutenant" <%= agent.grade === 'Lieutenant' ? 'selected' : '' %>>Lieutenant</option>
                                                        <option value="Sheriff" <%= agent.grade === 'Sheriff' ? 'selected' : '' %>>Sheriff</option>
                                                    </select>
                                                </div>
                                            </div>

                                            <div style="display: flex; gap: 20px; margin-bottom: 20px;">
                                                <label style="display: flex; align-items: center; gap: 10px; font-size: 0.9rem;">
                                                    <input type="checkbox" name="isAdmin" <%= agent.isAdmin ? 'checked' : '' %>> Accès Admin
                                                </label>
                                                <label style="display: flex; align-items: center; gap: 10px; font-size: 0.9rem;">
                                                    <input type="checkbox" name="canDeleteArchives" <%= agent.canDeleteArchives ? 'checked' : '' %>> Droit de Suppression
                                                </label>
                                            </div>

                                            <div style="display:flex; gap:10px;">
                                                <button type="submit" class="btn" style="width: auto;">Sauvegarder les modifications</button>
                                                <button type="button" class="btn" style="background: var(--bg-input); width: auto;" onclick="toggleEditRow('<%= agent._id %>')">Annuler</button>
                                            </div>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Danger Zone -->
    <div class="panel-box danger-zone">
        <h2><i class="fas fa-exclamation-triangle"></i> Zone Critique</h2>
        <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 20px;">Efface définitivement la totalité de la base de données des rapports d'opération.</p>
        
        <form action="/admin/purge-rapports" method="POST" onsubmit="return confirm('⚠️ ALERTE : Voulez-vous vraiment détruire l\'intégralité des rapports ?');">
            <button type="submit" class="btn btn-danger">Purger tous les rapports (<%= archivesCount %>)</button>
        </form>
    </div>
</div>

<script>
    function toggleEditRow(id) {
        const row = document.getElementById(`edit-${id}`);
        if (row.style.display === 'table-row') {
            row.style.display = 'none';
        } else {
            row.style.display = 'table-row';
        }
    }
</script>