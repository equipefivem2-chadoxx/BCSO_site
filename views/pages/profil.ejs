<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<style>
    :root {
        --primary: #bda581;
        --primary-glow: rgba(189, 165, 129, 0.2);
        --bg-dark: #05070b;
        --bg-panel: rgba(11, 15, 25, 0.75);
        --text-main: #e2e8f0;
        --border-glow: rgba(189, 165, 129, 0.25);
        --success: #10b981;
        --danger: #ef4444;
    }

    body {
        margin: 0;
        background-color: var(--bg-dark);
        background-image: 
            linear-gradient(rgba(189, 165, 129, 0.01) 1px, transparent 1px),
            linear-gradient(90deg, rgba(189, 165, 129, 0.01) 1px, transparent 1px);
        background-size: 30px 30px;
        font-family: 'Montserrat', sans-serif; 
        color: var(--text-main); 
        min-height: 100vh;
    }

    @keyframes fadeUp { 
        from { opacity: 0; transform: translateY(20px); } 
        to { opacity: 1; transform: translateY(0); } 
    }

    .profil-wrapper { 
        max-width: 900px; 
        margin: 40px auto 80px auto; 
        padding: 0 30px; 
        animation: fadeUp 0.5s ease-out forwards;
    }

    .profil-header { 
        display: flex; 
        align-items: center; 
        gap: 20px;
        margin-bottom: 35px; 
        background: var(--bg-panel); 
        padding: 30px; 
        border-radius: 16px; 
        border-top: 1px solid var(--border-glow); 
        backdrop-filter: blur(20px); 
        box-shadow: 0 15px 35px rgba(0,0,0,0.4); 
    }

    .profil-icon-large {
        width: 70px;
        height: 70px;
        background: rgba(189, 165, 129, 0.1);
        border: 2px solid var(--primary);
        border-radius: 12px;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 30px;
        color: var(--primary);
        box-shadow: 0 0 20px var(--primary-glow);
    }

    .profil-title h1 { 
        font-size: 24px; 
        font-weight: 900; 
        margin: 0; 
        color: #fff; 
        text-transform: uppercase; 
        letter-spacing: 2px; 
    }

    .profil-title p { 
        color: var(--primary); 
        margin: 5px 0 0 0; 
        font-weight: 700; 
        font-size: 13px; 
        letter-spacing: 2px; 
        text-transform: uppercase; 
    }

    .profil-form-container {
        background: var(--bg-panel);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(255,255,255,0.02);
        border-radius: 12px;
        padding: 40px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    }

    .form-group {
        margin-bottom: 25px;
    }

    .form-group label {
        display: block;
        color: #94a3b8;
        font-size: 0.85rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 10px;
    }

    .form-control {
        width: 100%;
        background: rgba(0, 0, 0, 0.3);
        border: 1px solid rgba(189, 165, 129, 0.2);
        color: #fff;
        padding: 15px 20px;
        border-radius: 8px;
        font-family: 'Montserrat', sans-serif;
        font-size: 1rem;
        transition: all 0.3s ease;
    }

    .form-control:focus {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 15px var(--primary-glow);
        background: rgba(0, 0, 0, 0.5);
    }

    .form-control:disabled {
        background: rgba(255, 255, 255, 0.02);
        color: #64748b;
        cursor: not-allowed;
        border-color: rgba(255, 255, 255, 0.05);
    }

    .btn-submit {
        background: var(--primary);
        color: #05070b;
        border: none;
        padding: 16px 30px;
        border-radius: 8px;
        font-weight: 800;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        cursor: pointer;
        width: 100%;
        transition: all 0.3s ease;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
        margin-top: 20px;
    }

    .btn-submit:hover {
        background: #d4af37;
        box-shadow: 0 0 20px rgba(212, 175, 55, 0.4);
        transform: translateY(-2px);
    }

    .alert {
        padding: 15px 20px;
        border-radius: 8px;
        margin-bottom: 25px;
        font-weight: 600;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .alert-success {
        background: rgba(16, 185, 129, 0.1);
        border: 1px solid var(--success);
        color: var(--success);
    }

    .alert-danger {
        background: rgba(239, 68, 68, 0.1);
        border: 1px solid var(--danger);
        color: var(--danger);
    }

    .grid-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

    /* 🚀 STYLES POUR LE SYSTÈME D'ARMEMENT */
    .section-divider {
        height: 1px;
        background: rgba(255, 255, 255, 0.05);
        margin: 35px 0;
    }

    .section-title {
        color: var(--primary);
        font-size: 1.1rem;
        font-weight: 800;
        text-transform: uppercase;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .arme-row {
        display: grid;
        grid-template-columns: 1fr 1fr 50px;
        gap: 15px;
        margin-bottom: 15px;
        align-items: end;
    }

    .btn-add-arme {
        background: rgba(189, 165, 129, 0.1);
        border: 1px dashed var(--primary);
        color: var(--primary);
        width: 100%;
        padding: 12px;
        border-radius: 8px;
        font-weight: 700;
        cursor: pointer;
        transition: 0.3s;
        margin-bottom: 10px;
    }

    .btn-add-arme:hover {
        background: var(--primary);
        color: #000;
    }

    .btn-remove-arme {
        background: rgba(239, 68, 68, 0.1);
        border: 1px solid var(--danger);
        color: var(--danger);
        height: 50px;
        border-radius: 8px;
        cursor: pointer;
        transition: 0.3s;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .btn-remove-arme:hover {
        background: var(--danger);
        color: #fff;
    }
</style>

<div class="profil-wrapper">
    <div class="profil-header">
        <div class="profil-icon-large">
            <i class="fas fa-id-card-clip"></i>
        </div>
        <div class="profil-title">
            <h1>Profil Agent</h1>
            <p>Gestion des informations personnelles et matérielles</p>
        </div>
    </div>

    <div class="profil-form-container">
        
        <script>
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.has('success')) {
                document.write('<div class="alert alert-success"><i class="fas fa-check-circle"></i> Informations mises à jour avec succès.</div>');
            } else if (urlParams.has('error')) {
                document.write('<div class="alert alert-danger"><i class="fas fa-exclamation-triangle"></i> Une erreur est survenue lors de la sauvegarde.</div>');
            }
        </script>

        <form action="/profil/update" method="POST" id="profilForm">
            <div class="grid-2">
                <div class="form-group">
                    <label>Prénom & Nom (Non modifiable)</label>
                    <input type="text" class="form-control" value="<%= agentDB.prenom %> <%= agentDB.nom %>" disabled>
                </div>
                <div class="form-group">
                    <label>Matricule (Non modifiable)</label>
                    <input type="text" class="form-control" value="<%= agentDB.matricule %>" disabled>
                </div>
            </div>

            <div class="form-group">
                <label>Grade Actuel (Non modifiable)</label>
                <input type="text" class="form-control" value="<%= agentDB.grade %>" disabled>
            </div>

            <div class="grid-2">
                <div class="form-group">
                    <label><i class="fas fa-phone"></i> Numéro de téléphone</label>
                    <input type="text" name="telephone" class="form-control" value="<%= agentDB.telephone !== 'Non renseigné' ? agentDB.telephone : '' %>" placeholder="Ex: 555-0123" required>
                </div>
                <div class="form-group">
                    <label><i class="fas fa-building-columns"></i> Relevé IBAN (Paie)</label>
                    <input type="text" name="iban" class="form-control" value="<%= agentDB.iban !== 'Non renseigné' ? agentDB.iban : '' %>" placeholder="Ex: LS123456789" required>
                </div>
            </div>

            <div class="section-divider"></div>

            <!-- 🚀 ZONE ARMURERIE -->
            <div class="section-title"><i class="fas fa-crosshairs"></i> Registre d'Armement</div>
            <p style="color: #94a3b8; font-size: 0.85rem; margin-bottom: 20px;">Veuillez déclarer toutes vos armes de service avec leur numéro de série exact.</p>

            <div id="armes-container">
                <% if(agentDB.armes && agentDB.armes.length > 0) { %>
                    <% agentDB.armes.forEach(function(arme) { %>
                        <div class="arme-row">
                            <div class="form-group" style="margin-bottom: 0;">
                                <label>Modèle de l'arme</label>
                                <input type="text" name="nomArme[]" class="form-control" value="<%= arme.nomArme %>" placeholder="Ex: Vom Fueur G17">
                            </div>
                            <div class="form-group" style="margin-bottom: 0;">
                                <label>Numéro de série</label>
                                <input type="text" name="idSerie[]" class="form-control" value="<%= arme.idSerie %>" placeholder="Ex: 837690GQZ397812">
                            </div>
                            <button type="button" class="btn-remove-arme" onclick="removeArme(this)"><i class="fas fa-trash"></i></button>
                        </div>
                    <% }); %>
                <% } %>
            </div>

            <button type="button" class="btn-add-arme" onclick="addArme()"><i class="fas fa-plus"></i> Ajouter une nouvelle arme de service</button>

            <button type="submit" class="btn-submit"><i class="fas fa-save"></i> Sauvegarder mon profil complet</button>
        </form>
    </div>
</div>

<script>
    // 🚀 FONCTION POUR AJOUTER UNE LIGNE D'ARME DYNAMIQUEMENT
    function addArme() {
        const container = document.getElementById('armes-container');
        const row = document.createElement('div');
        row.className = 'arme-row';
        row.innerHTML = `
            <div class="form-group" style="margin-bottom: 0;">
                <label>Modèle de l'arme</label>
                <input type="text" name="nomArme[]" class="form-control" placeholder="Ex: Vom Fueur G17">
            </div>
            <div class="form-group" style="margin-bottom: 0;">
                <label>Numéro de série</label>
                <input type="text" name="idSerie[]" class="form-control" placeholder="Ex: 837690GQZ397812">
            </div>
            <button type="button" class="btn-remove-arme" onclick="removeArme(this)"><i class="fas fa-trash"></i></button>
        `;
        container.appendChild(row);
    }

    // 🚀 FONCTION POUR SUPPRIMER UNE LIGNE D'ARME
    function removeArme(button) {
        button.parentElement.remove();
    }
</script>